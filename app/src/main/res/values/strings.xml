    <string name="app_name">סקרים בווטסאפ</string>

    <!-- Main screen -->
    <string name="intro">כשנפתח סקר בקבוצה שמסומנת כאן, הטלפון מצלצל ומראה \"יש סקר בקבוצה…\", עם כפתור שפותח אותו. האפליקציה קוראת רק את הווידג\'ט של ווטסאפ, בטלפון עצמו: שום דבר ממנו לא יוצא מהטלפון. רק הודעה שעוד לא נקראה מגיעה לווידג\'ט.</string>
    <string name="step_widget">① לחבר את הווידג\'ט של ווטסאפ (פעם אחת, באישור של אנדרואיד):</string>
    <string name="connect_widget">חיבור: %1$s</string>
    <string name="no_widget">לא נמצא בטלפון ווידג\'ט של ווטסאפ. צריך שווטסאפ יהיה מותקן.</string>
