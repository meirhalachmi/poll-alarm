    <string name="problem_unbound">הווידג\'ט של ווטסאפ התנתק מהאפליקציה (קורה לפעמים אחרי עדכון של ווטסאפ). אפשר לחבר אותו שוב במסך של האפליקציה.</string>
    <string name="problem_no_list">ווטסאפ שינו את הווידג\'ט, והאפליקציה לא מוצאת בו את רשימת ההודעות. סקרים לא יצלצלו עד שזה יתוקן: כדאי לשלוח את פרטי התקלה.</string>
    <string name="problem_unreadable">ווטסאפ שינו את הווידג\'ט, והאפליקציה לא מבינה את ההודעות בו. סקרים לא יצלצלו עד שזה יתוקן: כדאי לשלוח את פרטי התקלה.</string>
    <string name="problem_failing">הקריאה של הווידג\'ט נכשלת. סקרים לא יצלצלו עד שזה יתוקן: כדאי לשלוח את פרטי התקלה.</string>
    <string name="problem_stale">האפליקציה לא הצליחה לקרוא את הווידג\'ט כבר כמה שעות. אם זה לא עובר אחרי פתיחה של האפליקציה, כדאי לשלוח את פרטי התקלה.</string>
